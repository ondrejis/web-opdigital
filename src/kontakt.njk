---
layout: layouts/base.njk
permalink: /kontakt/
title: "Kontakt"
description: "Máte představu, zadání nebo jen nápad? Napište nám, co řešíte. Ozveme se do druhého pracovního dne."
---
{% include "partials/contact.njk" %}

<section class="section">
  <div class="wrap grid grid-cols-1 md:grid-cols-3 gap-px bg-line border-2 border-line" data-reveal-group>
    <div class="bg-bg p-8 md:p-12" data-reveal-item>
      <p class="eyebrow mb-6">E-mail</p>
      <a href="mailto:{{ site.email }}" class="text-xl md:text-2xl font-bold uppercase tracking-tighter link break-all">{{ site.email }}</a>
    </div>
    <div class="bg-bg p-8 md:p-12" data-reveal-item>
      <p class="eyebrow mb-6">Telefon</p>
      <a href="tel:{{ site.phoneHref }}" class="text-xl md:text-2xl font-bold uppercase tracking-tighter link">{{ site.phone }}</a>
      <p class="text-sm text-muted-fg mt-3">Po–Pá, 9–17 h</p>
    </div>
    <div class="bg-bg p-8 md:p-12" data-reveal-item>
      <p class="eyebrow mb-6">Sociální sítě</p>
      <ul class="space-y-2 text-xl md:text-2xl font-bold uppercase tracking-tighter">
        <li><a href="{{ site.social.instagram }}" rel="noopener" target="_blank" class="link">Instagram</a></li>
        <li><a href="{{ site.social.facebook }}" rel="noopener" target="_blank" class="link">Facebook</a></li>
        <li><a href="{{ site.social.linkedin }}" rel="noopener" target="_blank" class="link">LinkedIn</a></li>
      </ul>
    </div>
  </div>
</section>

{% set marqueeSpeed = 60 %}{% set marqueeInvert = true %}
{% include "partials/marquee-clients.njk" %}
