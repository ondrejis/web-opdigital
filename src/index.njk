---
layout: layouts/base.njk
permalink: /
description: "Vyvíjíme software na míru, tvoříme webové stránky a spravujeme reklamy, které pomáhají firmám růst. OP Digital – Ondřej a Patrik."
---

{# ============ 00 HERO ============ #}
<section class="relative overflow-hidden min-h-[calc(100svh-4rem)] md:min-h-[calc(100svh-5rem)] flex flex-col" data-hero>
  {# Vertikální marquee klientů na pravém okraji #}
  <div class="pointer-events-none absolute right-0 top-0 bottom-0 hidden lg:flex items-stretch border-l-2 border-line w-16 xl:w-20" aria-hidden="true">
    <div class="marquee-y h-full w-full" style="--marquee-duration: 70s">
      {% for copy in [1, 2] %}
        <ul class="marquee-y__track items-center gap-10 pb-10" {% if copy == 2 %}aria-hidden="true"{% endif %}>
          {% for c in clients %}
            <li class="py-6 text-sm font-bold uppercase tracking-widest text-muted-fg [writing-mode:vertical-rl] rotate-180 whitespace-nowrap">{{ c.name }}</li>
          {% endfor %}
        </ul>
      {% endfor %}
    </div>
  </div>

  <div class="wrap lg:pr-28 flex flex-col flex-1">
    {# Horní meta řádek #}
    <div class="flex items-center justify-between gap-4 py-5 text-xs md:text-sm font-bold uppercase tracking-widest text-muted-fg border-b-2 border-line" data-reveal>
      <span>Digitální agentura</span>
      <span class="hidden md:inline">Systémy · Weby · Kampaně</span>
      <span>Ondřej &amp; Patrik</span>
    </div>

    {# Titulek přes celou šířku #}
    <div class="flex-1 flex items-center py-8 md:py-10" data-hero-scale>
      <h1 class="w-full font-bold uppercase leading-[0.82] tracking-[-0.05em]" x-data="rotator(['systémy', 'webové stránky', 'poptávkové kampaně'])">
        <span class="block text-[clamp(3rem,12vw,13rem)]" data-reveal="clip">Stavíme</span>
        <span class="block text-accent text-[clamp(1.9rem,7.4vw,8.25rem)] my-[0.12em] min-h-[0.85em] leading-[0.85]" data-reveal="clip" data-reveal-delay="0.1">
          <span x-text="text">systémy</span><span class="inline-block w-[0.06em] h-[0.8em] align-baseline bg-accent ml-[0.05em] animate-blink motion-reduce:hidden" aria-hidden="true"></span>
        </span>
        <span class="block text-[clamp(3rem,12vw,13rem)]" data-reveal="clip" data-reveal-delay="0.2">na míru<span class="text-accent">.</span></span>
      </h1>
    </div>

    {# Spodní řádek: text + CTA #}
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-end border-t-2 border-line py-8 md:py-10">
      <p class="lead md:col-span-6 max-w-xl" data-reveal data-reveal-delay="0.3">{{ site.description }}</p>
      <div class="md:col-span-6 flex flex-col sm:flex-row gap-4 md:justify-end" data-reveal data-reveal-delay="0.4">
        <a href="/kontakt/" class="btn btn-primary btn-lg">Pojďme to probrat <span aria-hidden="true">→</span></a>
        <a href="#projekty" class="btn btn-outline btn-lg">Naše práce <span aria-hidden="true">↓</span></a>
      </div>
    </div>
  </div>
</section>

{# ============ STATS MARQUEE (rychlý, oranžový) ============ #}
<div class="marquee bg-accent text-accent-fg py-4 md:py-6 border-y-2 border-accent" style="--marquee-duration: 24s" aria-hidden="true">
  {% for copy in [1, 2] %}
    <ul class="marquee__track gap-12 md:gap-20 pr-12 md:pr-20">
      {% for s in [["27+", "webů za rok"], ["70 %", "domů prodáno za 5 měsíců"], ["247", "degustací pro RumMe"], ["2×", "víc poptávek pro kliniku"], ["16+", "firem, které nám důvěřují"], ["2", "lidi, žádná omáčka"]] %}
        <li class="flex items-baseline gap-4">
          <span class="text-4xl md:text-6xl font-bold tracking-tighter leading-none">{{ s[0] }}</span>
          <span class="text-sm md:text-lg font-bold uppercase tracking-widest">{{ s[1] }}</span>
          <span class="ml-8 text-2xl">✦</span>
        </li>
      {% endfor %}
    </ul>
  {% endfor %}
</div>

{# ============ 01 MANIFEST (slovo po slově) ============ #}
<section class="py-24 md:py-40">
  <div class="wrap">
    <p class="eyebrow mb-10 md:mb-16" data-reveal>01 / Co děláme</p>
    <p class="headline max-w-[18ch] text-balance" data-words>
      {% set manifest = ["Vyvíjíme", "software", "na", "míru,", "tvoříme", "webové", "stránky", "a", "spravujeme", "reklamy,", "které", "pomáhají", "firmám", "růst."] %}
      {% for w in manifest %}<span class="word {% if w in ['software', 'webové', 'stránky', 'reklamy,'] %}text-accent{% endif %}">{{ w }}</span>{% if not loop.last %} {% endif %}{% endfor %}
    </p>
  </div>
</section>

{# ============ 02 SLUŽBY – typografický seznam ============ #}
<section id="sluzby" class="border-b-2 border-line">
  <div class="wrap pb-8 md:pb-12">
    <p class="eyebrow" data-reveal>02 / Co pro vás můžeme postavit</p>
  </div>
  <div data-reveal-group>
    {% for s in services %}
      <a href="/{{ s.slug }}/" class="row-flood group block" data-reveal-item>
        <div class="wrap grid grid-cols-12 gap-x-4 md:gap-x-8 py-10 md:py-16 items-start">
          <span class="col-span-12 md:col-span-2 flood-muted text-xl md:text-3xl font-bold tracking-tighter text-muted-fg leading-none mb-4 md:mb-0 md:pt-3" aria-hidden="true">{{ s.number }}</span>
          <div class="col-span-12 md:col-span-9">
            <h2 class="flood-fg flood-shift headline text-balance">{{ s.shortTitle }}<span class="text-accent group-hover:text-accent-fg">.</span></h2>
            <p class="flood-fg text-xl md:text-3xl font-bold tracking-tight mt-5 md:mt-6">{{ s.tagline }}</p>
            <div class="mt-8 grid grid-cols-1 md:grid-cols-12 gap-6">
              <p class="flood-muted md:col-span-7 text-lg md:text-xl leading-tight text-muted-fg max-w-2xl">{{ s.text }}</p>
              <ul class="md:col-span-5 flex flex-wrap gap-2 content-start">
                {% for t in s.tags %}<li class="tag flood-fg border-current">{{ t }}</li>{% endfor %}
              </ul>
            </div>
          </div>
          <span class="col-span-12 md:col-span-1 flood-fg justify-self-end text-4xl md:text-6xl font-bold leading-none transition-transform duration-300 group-hover:translate-x-2 group-hover:-translate-y-2 mt-6 md:mt-0" aria-hidden="true">↗</span>
        </div>
      </a>
    {% endfor %}
  </div>
</section>

{# ============ 03 PROJEKTY – sticky panely ============ #}
<section id="projekty">
  <div class="wrap py-20 md:py-32">
    <p class="eyebrow mb-8" data-reveal>03 / Nedávno dokončené projekty</p>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end">
      <h2 class="headline lg:col-span-8 text-balance" data-reveal="clip">Každý projekt je jiný<span class="text-accent">.</span></h2>
      <p class="lead lg:col-span-4" data-reveal data-reveal-delay="0.1">Někde stavíme vše od základů, jinde hledáme způsob, jak posunout fungující byznys ještě dál.</p>
    </div>
  </div>

  <div>
    {% for cs in caseStudies %}
      {% if loop.index <= 3 %}
        {% set invert = (loop.index == 2) %}
        <a href="/pripadove-studie/{{ cs.slug }}/" class="group block lg:sticky lg:top-20 border-t-2 {% if invert %}bg-accent text-accent-fg border-accent{% else %}bg-bg text-fg border-line{% endif %} overflow-hidden">
          <div class="wrap lg:min-h-[80vh] grid grid-cols-1 lg:grid-cols-12 gap-8 py-12 md:py-20 relative">
            {# Obrovské jméno klienta jako grafika #}
            <span class="pointer-events-none select-none absolute -bottom-4 right-0 text-[clamp(4rem,14vw,16rem)] font-bold uppercase tracking-tighter leading-none whitespace-nowrap {% if invert %}text-accent-fg/10{% else %}text-muted-deep{% endif %}" aria-hidden="true" data-drift="left">{{ cs.client }}</span>

            <div class="lg:col-span-7 flex flex-col justify-between relative">
              <p class="eyebrow {% if invert %}text-accent-fg/70 [&::before]:bg-accent-fg{% endif %}">{{ loop.index | pad }} / {{ cs.category }} · {{ cs.client }}</p>
              <div class="mt-12 lg:mt-16">
                <h3 class="headline text-balance mb-6 transition-transform duration-300 group-hover:translate-x-4">{{ cs.title }}</h3>
                <p class="text-lg md:text-2xl leading-tight max-w-xl {% if invert %}text-accent-fg/80{% else %}text-muted-fg{% endif %}">{{ cs.summary }}</p>
                <span class="inline-flex items-center gap-3 mt-8 text-lg md:text-xl font-bold uppercase tracking-tighter">Detail projektu <span class="transition-transform duration-300 group-hover:translate-x-2" aria-hidden="true">→</span></span>
              </div>
            </div>

            <div class="lg:col-span-5 flex lg:flex-col lg:items-end lg:justify-end gap-10 relative">
              {% for st in cs.stats %}
                <div class="lg:text-right">
                  <span class="block text-[clamp(4rem,11vw,12rem)] font-bold tracking-tighter leading-none">{{ st.value }}{{ st.suffix }}</span>
                  <span class="block text-xs md:text-base font-bold uppercase tracking-widest mt-2 {% if invert %}text-accent-fg/70{% else %}text-muted-fg{% endif %}">{{ st.label }}</span>
                </div>
              {% endfor %}
            </div>
          </div>
        </a>
      {% endif %}
    {% endfor %}
    <div class="relative bg-bg border-t-2 border-line">
      <div class="wrap py-10 md:py-14 flex flex-col md:flex-row md:items-center justify-between gap-6">
        <p class="title">Chcete vidět víc<span class="text-accent">?</span></p>
        <a href="/pripadove-studie/" class="btn btn-outline btn-lg">Všechny projekty <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</section>

{# ============ 04 POSTUP ============ #}
<section id="spoluprace" class="section">
  <div class="wrap">
    <p class="eyebrow mb-8" data-reveal>04 / Spolupráce</p>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end mb-12 md:mb-20">
      <h2 class="headline lg:col-span-8 text-balance" data-reveal="clip">Od nápadu k hotové věci<span class="text-accent">.</span></h2>
      <p class="lead lg:col-span-4" data-reveal data-reveal-delay="0.1">Nemusíte mít všechno promyšlené do posledního detailu. Stačí nám říct, co řešíte. Společně najdeme cestu, jak to dostat do praxe.</p>
    </div>
    <ol class="hairline-grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4" data-reveal-group>
      {% for step in process %}
        <li class="group p-6 md:p-8 flex flex-col justify-between min-h-[60vh] lg:min-h-[70vh] hover:bg-accent hover:text-accent-fg transition-colors duration-300" data-reveal-item>
          <span class="text-[clamp(6rem,14vw,12rem)] font-bold tracking-tighter leading-[0.8] text-outline group-hover:text-accent-fg group-hover:[-webkit-text-stroke:0] transition-colors duration-300" aria-hidden="true">{{ loop.index | pad }}</span>
          <div>
            <h3 class="text-2xl md:text-3xl lg:text-4xl font-bold uppercase tracking-tighter leading-none mb-4 text-balance">{{ step.title }}</h3>
            <p class="text-base md:text-lg leading-tight text-muted-fg group-hover:text-accent-fg/80 transition-colors duration-300">{{ step.text }}</p>
          </div>
        </li>
      {% endfor %}
    </ol>
  </div>
</section>

{# ============ 05 REFERENCE – jen typografie v pohybu ============ #}
<section id="reference" class="section overflow-hidden">
  <div class="wrap mb-10 md:mb-16 flex flex-col md:flex-row md:items-end justify-between gap-6">
    <div>
      <p class="eyebrow mb-8" data-reveal>05 / Reference</p>
      <h2 class="headline" data-reveal="clip">Důvěřují nám<span class="text-accent">.</span></h2>
    </div>
    <a href="/reference/" class="btn btn-ghost px-0 text-xl" data-reveal>Všechny reference <span aria-hidden="true">→</span></a>
  </div>
  <div class="space-y-px bg-line border-y-2 border-line" data-reveal>
    {% set marqueeSpeed = 70 %}{% set marqueeInvert = false %}{% set marqueeOutline = true %}
    {% include "partials/marquee-clients.njk" %}
    {% set marqueeSpeed = 55 %}{% set marqueeInvert = false %}{% set marqueeOutline = false %}{% set marqueeReverse = true %}
    {% include "partials/marquee-clients.njk" %}
  </div>
</section>

{# ============ 06 TÝM ============ #}
{% include "partials/team.njk" %}

{# ============ 07 KONTAKT ============ #}
{% include "partials/contact.njk" %}
