---
layout: layouts/base.njk
pagination:
  data: caseStudies
  size: 1
  alias: cs
  addAllPagesToCollections: true
permalink: "/pripadove-studie/{{ cs.slug }}/"
eleventyComputed:
  title: "{{ cs.client }} – {{ cs.title }}"
  description: "{{ cs.summary }}"
---
{% set others = caseStudies | exclude("slug", cs.slug) %}
{% set next = others[0] %}

<section class="relative overflow-hidden border-b-2 border-line bg-grid">
  <span class="pointer-events-none select-none absolute -top-6 -right-4 text-[clamp(6rem,20vw,22rem)] font-bold uppercase tracking-tighter text-outline leading-none hidden md:block" aria-hidden="true" data-drift="right">{{ cs.client }}</span>
  <div class="wrap relative py-20 md:py-32">
    <p class="eyebrow mb-8" data-reveal><a href="/pripadove-studie/" class="hover:text-accent">Případové studie</a> · {{ cs.category }} · {{ cs.client }}</p>
    <h1 class="display text-balance max-w-[14ch]" data-reveal="clip">{{ cs.title }}</h1>
    <p class="lead max-w-2xl mt-10" data-reveal data-reveal-delay="0.1">{{ cs.summary }}</p>
  </div>
</section>

{% if cs.stats.length %}
<section class="border-b-2 border-line">
  <ul class="wrap grid grid-cols-1 {% if cs.stats.length == 2 %}sm:grid-cols-2{% elif cs.stats.length >= 3 %}sm:grid-cols-3{% endif %} divide-y-2 sm:divide-y-0 sm:divide-x-2 divide-line" data-reveal-group>
    {% for st in cs.stats %}
      <li class="py-12 md:py-20 sm:px-8 first:pl-0" data-reveal-item x-data="counter({{ st.value }})" x-intersect.once="start()">
        <span class="block text-[clamp(4rem,12vw,11rem)] font-bold tracking-tighter leading-none"><span x-text="value">{{ st.value }}</span>{{ st.suffix }}</span>
        <span class="eyebrow mt-4">{{ st.label }}</span>
      </li>
    {% endfor %}
  </ul>
</section>
{% endif %}

<section class="py-20 md:py-32">
  <div class="wrap">
    {# Screenshot / placeholder #}
    <div class="relative aspect-[21/9] border-2 border-line bg-muted-deep bg-grid mb-20 md:mb-32 overflow-hidden" data-reveal>
      {% if cs.screenshot %}
        <img src="{{ cs.screenshot }}" alt="Náhled webu {{ cs.client }}" class="absolute inset-0 h-full w-full object-cover object-top">
      {% else %}
        <span class="absolute inset-0 flex items-center justify-center text-[clamp(2.5rem,10vw,12rem)] font-bold uppercase tracking-tighter text-outline leading-none px-6 text-center" aria-hidden="true">{{ cs.client }}</span>
        <span class="absolute bottom-6 left-6 eyebrow">Ukázka projektu</span>
      {% endif %}
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-px bg-line border-2 border-line" data-reveal-group>
      {% for block in [["01", "Zadání", cs.brief], ["02", "Řešení", cs.solution], ["03", "Výsledek", cs.result]] %}
        <article class="bg-bg p-8 md:p-12 relative overflow-hidden group hover:bg-accent hover:text-accent-fg transition-colors duration-300" data-reveal-item>
          <span class="giant-number absolute -top-6 -right-4 group-hover:text-accent-fg/10 transition-colors duration-300" aria-hidden="true">{{ block[0] }}</span>
          <p class="eyebrow mb-16 relative">{{ block[0] }} / {{ block[1] }}</p>
          <h2 class="relative text-3xl md:text-5xl font-bold uppercase tracking-tighter leading-none mb-6">{{ block[1] }}<span class="text-accent group-hover:text-accent-fg">.</span></h2>
          <p class="relative text-lg md:text-xl leading-tight text-muted-fg group-hover:text-accent-fg/80 transition-colors duration-300">{{ block[2] }}</p>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% if next %}
<section class="section">
  <div class="wrap">
    <p class="eyebrow mb-8" data-reveal>Další projekt</p>
    <a href="/pripadove-studie/{{ next.slug }}/" class="group block" data-reveal>
      <span class="block headline text-balance group-hover:text-accent transition-colors duration-300">{{ next.title }} <span class="inline-block transition-transform duration-300 group-hover:translate-x-4" aria-hidden="true">→</span></span>
      <span class="eyebrow mt-6">{{ next.category }} · {{ next.client }}</span>
    </a>
  </div>
</section>
{% endif %}

{% set ctaTitle = "Chcete podobný výsledek?" %}
{% include "partials/cta-band.njk" %}
