<header
  x-data="header"
  :class="scrolled || open ? 'bg-bg border-line' : 'bg-transparent border-transparent'"
  class="fixed inset-x-0 top-0 z-40 border-b-2 transition-colors duration-300"
>
  <div class="wrap">
    {# Horní mikro-lišta: sekundární navigace #}
    <div class="hidden md:flex items-center justify-end gap-8 h-10 text-xs lg:text-sm uppercase tracking-widest text-muted-fg border-b border-line/60">
      {% for item in site.navSecondary %}
        <a href="{{ item.url }}" class="nav-link font-medium" {% if page.url == item.url %}aria-current="page"{% endif %}>{{ item.label }}</a>
      {% endfor %}
    </div>

    {# Hlavní lišta #}
    <div class="flex items-center justify-between h-16 md:h-20">
      <a href="/" class="flex items-center gap-3 shrink-0" aria-label="{{ site.name }} – úvodní stránka">
        <img src="/assets/img/logo.svg" alt="{{ site.name }}" width="131" height="50" class="h-9 md:h-11 w-auto">
      </a>

      <nav class="hidden md:flex items-center gap-8 lg:gap-12 text-base lg:text-lg" aria-label="Hlavní navigace">
        {% for item in site.navMain %}
          <a href="{{ item.url }}" class="nav-link" {% if page.url == item.url %}aria-current="page"{% endif %}>{{ item.label }}</a>
        {% endfor %}
      </nav>

      <div class="flex items-center gap-3">
        <a href="{{ site.cta.url }}" class="btn btn-primary btn-sm md:h-12 md:px-6 md:text-base">{{ site.cta.label }}</a>
        <button
          type="button"
          class="md:hidden flex h-11 w-11 items-center justify-center border-2 border-line text-fg"
          :aria-expanded="open"
          aria-controls="mobilni-menu"
          @click="open = !open"
        >
          <span class="sr-only" x-text="open ? 'Zavřít menu' : 'Otevřít menu'"></span>
          <span class="relative block h-4 w-6" aria-hidden="true">
            <span class="absolute left-0 top-0 h-0.5 w-6 bg-current transition-transform duration-200" :class="open && 'translate-y-[7px] rotate-45'"></span>
            <span class="absolute left-0 top-[7px] h-0.5 w-6 bg-current transition-opacity duration-200" :class="open && 'opacity-0'"></span>
            <span class="absolute left-0 bottom-0 h-0.5 w-6 bg-current transition-transform duration-200" :class="open && '-translate-y-[7px] -rotate-45'"></span>
          </span>
        </button>
      </div>
    </div>
  </div>

  {# Mobilní menu – celá obrazovka, obří typografie #}
  <div
    id="mobilni-menu"
    x-cloak
    x-show="open"
    x-transition.opacity.duration.200ms
    class="md:hidden fixed inset-x-0 top-16 bottom-0 z-40 bg-bg overflow-y-auto"
    @keydown.escape.window="open = false"
  >
    <nav class="wrap py-8 flex flex-col" aria-label="Mobilní navigace">
      {% for item in site.navMain %}
        <a href="{{ item.url }}" class="block border-b-2 border-line py-5 text-5xl font-bold uppercase tracking-tighter leading-none hover:text-accent" @click="open = false">
          <span class="text-sm text-muted-fg tracking-widest mr-3 align-top">{{ loop.index | pad }}</span>{{ item.label }}
        </a>
      {% endfor %}
      <div class="mt-8 flex flex-col gap-4 text-xl font-bold uppercase tracking-tight text-muted-fg">
        {% for item in site.navSecondary %}
          <a href="{{ item.url }}" class="hover:text-accent" @click="open = false">{{ item.label }}</a>
        {% endfor %}
      </div>
      <a href="{{ site.cta.url }}" class="btn btn-primary btn-lg mt-10 w-full" @click="open = false">{{ site.cta.label }} →</a>
      <div class="mt-10 text-muted-fg text-sm">
        <a href="mailto:{{ site.email }}" class="link">{{ site.email }}</a><br>
        <a href="tel:{{ site.phoneHref }}" class="link">{{ site.phone }}</a>
      </div>
    </nav>
  </div>
</header>
{# Rezervované místo pod fixní hlavičkou #}
<div class="h-16 md:h-[7.5rem]" aria-hidden="true"></div>
