<header
  x-data="header"
  :class="scrolled || open ? 'bg-bg border-line' : 'bg-transparent border-transparent'"
  class="fixed inset-x-0 top-0 z-40 border-b-2 transition-colors duration-300"
>
  <div class="wrap flex items-center justify-between h-16 md:h-20">
    <a href="/" class="flex items-center shrink-0" aria-label="{{ site.name }} – úvodní stránka">
      <img src="/assets/img/logo.svg" alt="{{ site.name }}" width="131" height="50" class="h-9 md:h-11 w-auto">
    </a>

    <nav class="hidden lg:flex items-center gap-8 xl:gap-10 text-base" aria-label="Hlavní navigace">
      {% for item in site.navMain %}
        <a href="{{ item.url }}" class="nav-link" {% if page.url == item.url %}aria-current="page"{% endif %}>{{ item.label }}</a>
      {% endfor %}
      <span class="h-5 w-0.5 bg-line" aria-hidden="true"></span>
      {% for item in site.navSecondary %}
        <a href="{{ item.url }}" class="nav-link text-muted-fg" {% if page.url == item.url %}aria-current="page"{% endif %}>{{ item.label }}</a>
      {% endfor %}
    </nav>

    <div class="flex items-center gap-3">
      <a href="{{ site.cta.url }}" class="btn btn-primary btn-sm md:h-12 md:px-6 md:text-base">{{ site.cta.label }}</a>
      <button type="button" class="lg:hidden flex h-11 w-11 items-center justify-center border-2 border-line text-fg" :aria-expanded="open" aria-controls="mobilni-menu" @click="open = !open">
        <span class="sr-only" x-text="open ? 'Zavřít menu' : 'Otevřít menu'"></span>
        <span class="relative block h-4 w-6" aria-hidden="true">
          <span class="absolute left-0 top-0 h-0.5 w-6 bg-current transition-transform duration-200" :class="open && 'translate-y-[7px] rotate-45'"></span>
          <span class="absolute left-0 top-[7px] h-0.5 w-6 bg-current transition-opacity duration-200" :class="open && 'opacity-0'"></span>
          <span class="absolute left-0 bottom-0 h-0.5 w-6 bg-current transition-transform duration-200" :class="open && '-translate-y-[7px] -rotate-45'"></span>
        </span>
      </button>
    </div>
  </div>

  {# Mobilní menu: obří typografie přes celou obrazovku #}
  <div id="mobilni-menu" x-cloak x-show="open" x-transition.opacity.duration.200ms class="lg:hidden fixed inset-x-0 top-16 md:top-20 bottom-0 z-40 bg-bg overflow-y-auto" @keydown.escape.window="open = false">
    <nav class="wrap py-6 flex flex-col" aria-label="Mobilní navigace">
      {% for item in site.navMain %}
        <a href="{{ item.url }}" class="flex items-baseline gap-4 border-b-2 border-line py-4 text-[clamp(2.5rem,12vw,5rem)] font-bold uppercase tracking-tighter leading-none hover:text-accent" @click="open = false">
          <span class="text-sm text-muted-fg tracking-widest">{{ loop.index | pad }}</span>{{ item.label }}
        </a>
      {% endfor %}
      <div class="mt-8 grid grid-cols-2 gap-4 text-lg font-bold uppercase tracking-tight text-muted-fg">
        {% for item in site.navSecondary %}<a href="{{ item.url }}" class="hover:text-accent" @click="open = false">{{ item.label }}</a>{% endfor %}
      </div>
      <a href="{{ site.cta.url }}" class="btn btn-primary btn-lg mt-10 w-full" @click="open = false">{{ site.cta.label }} →</a>
      <p class="mt-8 text-sm text-muted-fg"><a href="mailto:{{ site.email }}" class="link">{{ site.email }}</a> · <a href="tel:{{ site.phoneHref }}" class="link">{{ site.phone }}</a></p>
    </nav>
  </div>
</header>
<div class="h-16 md:h-20" aria-hidden="true"></div>
