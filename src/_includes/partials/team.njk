<section id="tym" class="section relative overflow-hidden">
  <div class="wrap">
    <p class="eyebrow mb-8" data-reveal>Kdo za tím stojí</p>
    <h2 class="headline text-balance mb-12 md:mb-20" data-reveal="clip">Za každým projektem stojíme my<span class="text-accent">.</span></h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8" data-reveal-group>
      {% for person in team %}
        <article class="border-2 border-line group" data-reveal-item>
          <div class="relative aspect-[4/5] md:aspect-[4/4] bg-muted-deep border-b-2 border-line overflow-hidden bg-grid">
            {% if person.photo %}
              <img src="{{ person.photo }}" alt="{{ person.name }}" class="absolute inset-0 h-full w-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500" loading="lazy" width="800" height="800">
            {% else %}
              <span class="absolute inset-0 flex items-center justify-center text-[clamp(6rem,22vw,20rem)] font-bold tracking-tighter text-outline leading-none" aria-hidden="true">{{ person.initials }}</span>
              <span class="absolute bottom-6 left-6 eyebrow">Fotografie</span>
            {% endif %}
            <span class="absolute top-6 right-6 h-3 w-3 bg-accent" aria-hidden="true"></span>
          </div>
          <div class="p-8 md:p-12">
            <h3 class="text-3xl md:text-5xl font-bold uppercase tracking-tighter leading-none mb-3">{{ person.name }}</h3>
            <p class="text-accent font-bold uppercase tracking-tight text-sm md:text-base mb-6">{{ person.role }}</p>
            <p class="text-lg md:text-xl leading-tight text-muted-fg mb-8 max-w-lg">{{ person.bio }}</p>
            <ul class="space-y-2 text-base md:text-lg font-medium">
              {% if person.email %}<li><a href="mailto:{{ person.email }}" class="link">{{ person.email }}</a></li>{% endif %}
              {% if person.phone %}<li><a href="tel:{{ person.phoneHref }}" class="link">{{ person.phone }}</a></li>{% endif %}
            </ul>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

