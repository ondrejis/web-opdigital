<section id="tym" class="section overflow-hidden">
  <div class="wrap">
    <p class="eyebrow mb-8" data-reveal>06 / Kdo za tím stojí</p>
    <h2 class="headline text-balance mb-12 md:mb-20 max-w-[12ch]" data-reveal="clip">Za každým projektem stojíme my<span class="text-accent">.</span></h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 lg:gap-12" data-reveal-group>
      {% for person in team %}
        <article class="group {% if loop.index == 2 %}md:mt-32{% endif %}" data-reveal-item>
          <div class="relative aspect-[3/4] border-2 border-line bg-muted-deep overflow-hidden bg-grid">
            {% if person.photo %}
              <img src="{{ person.photo }}" alt="{{ person.name }}" class="absolute inset-0 h-full w-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500" loading="lazy" width="900" height="1200">
            {% else %}
              <span class="absolute inset-0 flex items-center justify-center text-[clamp(8rem,28vw,24rem)] font-bold tracking-tighter text-outline leading-none" aria-hidden="true">{{ person.initials }}</span>
            {% endif %}
            {# Jméno přes fotku #}
            <h3 class="absolute inset-x-0 bottom-0 p-5 md:p-8 text-[clamp(2rem,5vw,4.5rem)] font-bold uppercase tracking-tighter leading-[0.85] bg-bg/0">
              <span class="block">{{ person.name.split(" ")[0] }}</span>
              <span class="block text-accent">{{ person.name.split(" ")[1] }}</span>
            </h3>
            <span class="absolute top-5 right-5 h-3 w-3 bg-accent" aria-hidden="true"></span>
          </div>
          <div class="pt-6 md:pt-8 grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <p class="eyebrow mb-3">{{ person.role }}</p>
              <p class="text-base md:text-lg leading-tight text-muted-fg">{{ person.bio }}</p>
            </div>
            <ul class="space-y-2 text-base md:text-lg font-bold sm:text-right">
              {% if person.email %}<li><a href="mailto:{{ person.email }}" class="link">{{ person.email }}</a></li>{% endif %}
              {% if person.phone %}<li><a href="tel:{{ person.phoneHref }}" class="link">{{ person.phone }}</a></li>{% endif %}
            </ul>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>
