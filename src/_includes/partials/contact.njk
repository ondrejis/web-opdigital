{# Kontakt: obří titulek + formulář přes celou šířku #}
<section id="kontakt" class="section relative overflow-hidden">
  <div class="wrap">
    <p class="eyebrow mb-8" data-reveal>{% if contactNumber %}{{ contactNumber }} / {% endif %}Kontakt</p>
    <h2 class="display text-balance mb-12 md:mb-20" data-reveal="clip">Máte představu? <span class="text-accent">Sem s ní.</span></h2>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
      <div class="lg:col-span-5">
        <p class="lead mb-12" data-reveal>Máte představu, zadání, nebo zatím jen nápad? Napište nám, co řešíte. Rádi si vás poslechneme a společně zjistíme, jak se do toho pustit.</p>
        <div class="space-y-10" data-reveal-group>
          <div data-reveal-item>
            <p class="eyebrow mb-3">Raději napíšete přímo?</p>
            <a href="mailto:{{ site.email }}" class="block text-2xl md:text-4xl lg:text-5xl font-bold uppercase tracking-tighter leading-none hover:text-accent transition-colors break-all">{{ site.email }}</a>
          </div>
          <div data-reveal-item>
            <p class="eyebrow mb-3">Nebo zavolejte</p>
            <a href="tel:{{ site.phoneHref }}" class="block text-2xl md:text-4xl lg:text-5xl font-bold uppercase tracking-tighter leading-none hover:text-accent transition-colors">{{ site.phone }}</a>
          </div>
        </div>
      </div>

      <form x-data="contactForm('{{ site.formEndpoint }}', '{{ site.email }}')" @submit.prevent="submit" class="lg:col-span-7" data-reveal data-reveal-delay="0.1">
        <div class="space-y-6 md:space-y-10" x-show="status !== 'sent'">
          <label class="block">
            <span class="field-label">Jak vám říkat?</span>
            <input type="text" name="name" x-model="name" class="input-xl" placeholder="Vaše jméno" autocomplete="name" required>
          </label>
          <label class="block">
            <span class="field-label">Kam se vám ozvat?</span>
            <input type="email" name="email" x-model="email" class="input-xl" placeholder="vas@email.cz" autocomplete="email" required>
          </label>
          <label class="block">
            <span class="field-label">Co máte v hlavě?</span>
            <textarea name="message" x-model="message" class="input-xl" rows="3" placeholder="Pár slov o projektu…" required></textarea>
          </label>
          <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true">
          <div class="flex flex-col md:flex-row md:items-center gap-6 pt-2">
            <button type="submit" class="btn btn-primary btn-lg w-full md:w-auto" :disabled="status === 'sending'">
              <span x-text="status === 'sending' ? 'Odesílám…' : 'Odeslat'"></span>
              <span aria-hidden="true">→</span>
            </button>
            <p class="text-xs md:text-sm text-muted-fg">Odesláním souhlasíte se <a href="/ochrana-osobnich-udaju/" class="link">zpracováním osobních údajů</a>.</p>
          </div>
          <p class="text-sm text-accent" x-show="status === 'error'" x-cloak>Něco se pokazilo. Napište nám prosím přímo na {{ site.email }}.</p>
        </div>
        <div x-show="status === 'sent'" x-cloak class="py-8">
          <p class="headline text-accent mb-4">Díky<span class="text-fg">.</span></p>
          <p class="lead">Máme to. Ozveme se vám nejpozději do druhého pracovního dne.</p>
        </div>
      </form>
    </div>
  </div>
</section>
