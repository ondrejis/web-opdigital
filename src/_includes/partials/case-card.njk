{# Karta případové studie – očekává proměnnou `cs` (a volitelně `wide`) #}
<a href="/pripadove-studie/{{ cs.slug }}/" class="card-flood group p-0! flex flex-col {% if wide %}md:col-span-2{% endif %}" data-reveal-item>
  <div class="relative {% if wide %}aspect-[21/9]{% else %}aspect-[16/10]{% endif %} border-b-2 border-line group-hover:border-accent-fg/30 bg-muted-deep group-hover:bg-accent-fg/10 overflow-hidden transition-colors duration-300 bg-grid">
    {% if cs.screenshot %}
      <img src="{{ cs.screenshot }}" alt="Náhled webu {{ cs.client }}" class="absolute inset-0 h-full w-full object-cover object-top" loading="lazy">
    {% else %}
      <span class="absolute inset-0 flex items-center justify-center text-[clamp(2.5rem,8vw,9rem)] font-bold uppercase tracking-tighter text-outline group-hover:text-accent-fg/40 transition-colors duration-300 px-6 text-center leading-none" aria-hidden="true">{{ cs.client }}</span>
    {% endif %}
  </div>
  <div class="p-8 md:p-12 flex flex-col grow">
    <div class="flex items-start justify-between gap-4 mb-6">
      <p class="eyebrow">{{ cs.category }} · {{ cs.client }}</p>
      <span class="card-title text-2xl transition-transform duration-300 group-hover:-translate-y-1 group-hover:translate-x-1" aria-hidden="true">↗</span>
    </div>
    <h3 class="card-title {% if wide %}text-[clamp(2rem,5vw,5rem)]{% else %}text-[clamp(1.75rem,3vw,3rem)]{% endif %} font-bold uppercase tracking-tighter leading-[0.9] mb-4 text-balance">{{ cs.title }}</h3>
    <p class="card-text text-lg md:text-xl leading-tight max-w-2xl">{{ cs.summary }}</p>
    {% if cs.stats.length %}
      <ul class="mt-8 flex flex-wrap gap-x-10 gap-y-4">
        {% for st in cs.stats %}
          <li>
            <span class="card-title block text-4xl md:text-6xl font-bold tracking-tighter leading-none">{{ st.value }}{{ st.suffix }}</span>
            <span class="card-text block text-xs md:text-sm uppercase tracking-widest mt-2">{{ st.label }}</span>
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</a>
