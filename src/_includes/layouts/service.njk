---
layout: layouts/base.njk
---
{% set service = services | find("slug", serviceSlug) %}
{% set related = caseStudies | where("categorySlug", service.slug) %}

{# ---------- HERO ---------- #}
<section class="relative overflow-hidden border-b-2 border-line bg-grid">
  <span class="giant-number absolute -top-10 -right-6 text-[clamp(10rem,30vw,26rem)]" aria-hidden="true" data-drift="right">{{ service.number }}</span>
  <div class="wrap relative py-20 md:py-32">
    <p class="eyebrow mb-8" data-reveal>{{ service.number }} / {{ service.label }}</p>
    <h1 class="display text-balance max-w-[14ch] mb-10" data-reveal="clip">{{ service.title }}</h1>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end">
      <div class="lg:col-span-7">
        <p class="text-2xl md:text-4xl font-bold tracking-tight leading-none mb-6" data-reveal data-reveal-delay="0.1">{{ service.tagline }}</p>
        <p class="lead max-w-2xl" data-reveal data-reveal-delay="0.2">{{ service.intro }}</p>
      </div>
      <div class="lg:col-span-5 flex flex-col sm:flex-row gap-4 lg:justify-end" data-reveal data-reveal-delay="0.3">
        <a href="#kontakt" class="btn btn-primary btn-lg">Pojďme to probrat <span aria-hidden="true">→</span></a>
        <a href="#nabidka" class="btn btn-outline btn-lg">Co děláme <span aria-hidden="true">↓</span></a>
      </div>
    </div>
  </div>
</section>

{# ---------- MARQUEE TAGŮ ---------- #}
<div class="marquee bg-accent text-accent-fg py-3 md:py-4" style="--marquee-duration: 20s" aria-hidden="true">
  {% for copy in [1, 2] %}
    <ul class="marquee__track gap-8 pr-8 text-xl md:text-3xl font-bold uppercase tracking-tighter">
      {% for t in service.tags %}<li class="flex items-center gap-8"><span>{{ t }}</span><span class="text-base md:text-xl">✦</span></li>{% endfor %}
      {% for b in service.benefits %}<li class="flex items-center gap-8"><span>{{ b.title }}</span><span class="text-base md:text-xl">✦</span></li>{% endfor %}
    </ul>
  {% endfor %}
</div>

{# ---------- PROČ ---------- #}
<section class="section">
  <div class="wrap">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 md:mb-20">
      <h2 class="headline text-balance" data-reveal="clip">Proč to dává smysl<span class="text-accent">.</span></h2>
      <p class="lead max-w-md" data-reveal data-reveal-delay="0.1">{{ service.text }}</p>
    </div>
    <ul class="hairline-grid grid-cols-1 md:grid-cols-2" data-reveal-group>
      {% for b in service.benefits %}
        <li class="group relative overflow-hidden p-8 md:p-12 min-h-[40vh] flex flex-col justify-end hover:bg-accent hover:text-accent-fg transition-colors duration-300" data-reveal-item>
          <span class="giant-number absolute -top-6 -right-4 group-hover:text-accent-fg/10 transition-colors duration-300" aria-hidden="true">{{ loop.index | pad }}</span>
          <h3 class="relative text-3xl md:text-5xl font-bold uppercase tracking-tighter leading-none mb-4 transition-transform duration-300 group-hover:translate-x-4">{{ b.title }}</h3>
          <p class="relative text-lg md:text-xl leading-tight text-muted-fg group-hover:text-accent-fg/80 max-w-md transition-colors duration-300">{{ b.text }}</p>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

{# ---------- NABÍDKA ---------- #}
<section id="nabidka" class="section">
  <div class="wrap">
    <h2 class="headline text-balance mb-12 md:mb-20" data-reveal="clip">Co pro vás uděláme<span class="text-accent">.</span></h2>
    <ol class="border-t-2 border-line" data-reveal-group>
      {% for o in service.offer %}
        <li class="group grid grid-cols-12 gap-4 md:gap-8 items-start border-b-2 border-line py-8 md:py-12 hover:border-accent transition-colors duration-300" data-reveal-item>
          <span class="col-span-12 md:col-span-2 text-5xl md:text-7xl lg:text-8xl font-bold tracking-tighter leading-none text-muted group-hover:text-accent transition-colors duration-300" aria-hidden="true">{{ loop.index | pad }}</span>
          <h3 class="col-span-12 md:col-span-5 text-2xl md:text-4xl lg:text-5xl font-bold uppercase tracking-tighter leading-none transition-transform duration-300 md:group-hover:translate-x-6">{{ o.title }}</h3>
          <p class="col-span-12 md:col-span-5 text-lg md:text-xl leading-tight text-muted-fg">{{ o.text }}</p>
        </li>
      {% endfor %}
    </ol>
  </div>
</section>

{# ---------- SOUVISEJÍCÍ PROJEKTY ---------- #}
{% if related.length %}
<section class="section">
  <div class="wrap">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 md:mb-20">
      <h2 class="headline text-balance" data-reveal="clip">Jak to vypadá v praxi<span class="text-accent">.</span></h2>
      <a href="/pripadove-studie/" class="btn btn-outline" data-reveal>Všechny případové studie <span aria-hidden="true">→</span></a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8" data-reveal-group>
      {% for cs in related %}
        {% if loop.index <= 2 %}
          {% include "partials/case-card.njk" %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{# ---------- POSTUP (kompaktně) ---------- #}
<section class="section">
  <div class="wrap">
    <p class="eyebrow mb-8" data-reveal>Jak spolupráce probíhá</p>
    <h2 class="headline text-balance mb-12 md:mb-20" data-reveal="clip">Od nápadu k hotové věci<span class="text-accent">.</span></h2>
    <ol class="hairline-grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4" data-reveal-group>
      {% for step in process %}
        <li class="p-8 md:p-10 min-h-72 flex flex-col justify-between group hover:bg-accent hover:text-accent-fg transition-colors duration-300" data-reveal-item>
          <span class="text-6xl md:text-7xl font-bold tracking-tighter leading-none text-muted group-hover:text-accent-fg/30 transition-colors duration-300" aria-hidden="true">{{ loop.index | pad }}</span>
          <div class="mt-10">
            <h3 class="text-2xl md:text-3xl font-bold uppercase tracking-tighter leading-none mb-3">{{ step.title }}</h3>
            <p class="text-base md:text-lg leading-tight text-muted-fg group-hover:text-accent-fg/80 transition-colors duration-300">{{ step.text }}</p>
          </div>
        </li>
      {% endfor %}
    </ol>
  </div>
</section>

{# ---------- FAQ ---------- #}
<section class="section">
  <div class="wrap grid grid-cols-1 lg:grid-cols-12 gap-12">
    <div class="lg:col-span-4">
      <p class="eyebrow mb-8" data-reveal>Časté otázky</p>
      <h2 class="headline text-balance lg:sticky lg:top-40" data-reveal="clip">Na co se ptáte<span class="text-accent">?</span></h2>
    </div>
    <div class="lg:col-span-8 border-t-2 border-line" x-data="accordion" data-reveal>
      {% for f in service.faq %}
        <div class="border-b-2 border-line">
          <h3>
            <button type="button" class="flex w-full items-start justify-between gap-6 py-6 md:py-8 text-left text-xl md:text-3xl font-bold uppercase tracking-tighter leading-none hover:text-accent transition-colors" :aria-expanded="active === {{ loop.index0 }}" aria-controls="faq-{{ loop.index0 }}" @click="toggle({{ loop.index0 }})">
              <span>{{ f.q }}</span>
              <span class="shrink-0 text-accent transition-transform duration-300" :class="active === {{ loop.index0 }} && 'rotate-45'" aria-hidden="true">+</span>
            </button>
          </h3>
          <div id="faq-{{ loop.index0 }}" x-show="active === {{ loop.index0 }}" x-collapse x-cloak>
            <p class="pb-8 text-lg md:text-xl leading-tight text-muted-fg max-w-2xl">{{ f.a }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% set marqueeSpeed = 90 %}{% set marqueeInvert = true %}
{% include "partials/marquee-clients.njk" %}
{% include "partials/contact.njk" %}
