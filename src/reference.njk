{% set heroEyebrow = "Reference" %}
{% set heroTitle = 'Důvěřují nám<span class="text-accent">.</span>' %}
{% set heroLead = "Stavební firmy, kliniky, výroba, služby i značky, které teprve začínaly. Různé obory, stejný přístup: poslouchat, navrhnout, postavit, dotáhnout." %}
{% set heroCta = true %}{% set heroCtaLabel = "Případové studie" %}{% set heroCtaUrl = "/pripadove-studie/" %}
{% include "partials/page-hero.njk" %}

{% set marqueeSpeed = 50 %}{% set marqueeInvert = true %}
{% include "partials/marquee-clients.njk" %}

<section class="border-b-2 border-line">
  <ol class="grid grid-cols-1 md:grid-cols-2" data-reveal-group>
    {% for c in clients %}
      <li class="row-flood group {% if loop.index % 2 == 0 %}md:border-l-2 md:border-l-line{% endif %}" data-reveal-item>
        <div class="px-4 md:px-8 py-8 md:py-10 flex items-baseline gap-6">
          <span class="flood-muted text-sm md:text-base font-bold tracking-widest text-muted-fg" aria-hidden="true">{{ loop.index | pad }}</span>
          {% if c.logo %}
            <img src="{{ c.logo }}" alt="{{ c.name }}" class="h-10 w-auto" loading="lazy">
          {% else %}
            <span class="flood-fg flood-shift text-[clamp(1.75rem,4vw,3.75rem)] font-bold uppercase tracking-tighter leading-none">{{ c.name }}</span>
          {% endif %}
        </div>
      </li>
    {% endfor %}
  </ol>
  <p class="wrap py-6 text-xs md:text-sm text-muted-fg uppercase tracking-widest">… a další. Seznam průběžně doplňujeme.</p>
</section>

